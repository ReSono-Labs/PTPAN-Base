{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "federation-control/v3",
  "title": "PTPAN control event",
  "description": "Project-owned durable control events between platforms. Agents are named only by address and requester reference (D5, D10); humans by the name on their own platform's account (D6). No internal account or agent ID, task body or credential is carried.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "kind",
    "sender_platform_id",
    "recipient_platform_id",
    "originating_platform_id",
    "relationship_id",
    "request_id",
    "actor_side",
    "actor_revision",
    "created_at",
    "delivery_expires_at",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "federation-control/v3"
    },
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "kind": {
      "enum": [
        "RELATIONSHIP_REQUEST",
        "RELATIONSHIP_DECISION",
        "RELATIONSHIP_REVOKE",
        "RELATIONSHIP_STATUS",
        "SOURCE_AUTHORIZATION_STATUS",
        "CONFIG_ACK",
        "PAIR_BLOCK_STATUS"
      ]
    },
    "sender_platform_id": {
      "$ref": "#/$defs/id"
    },
    "recipient_platform_id": {
      "$ref": "#/$defs/id"
    },
    "originating_platform_id": {
      "$ref": "#/$defs/id"
    },
    "relationship_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_side": {
      "enum": [
        "SOURCE",
        "DESTINATION"
      ]
    },
    "actor_revision": {
      "$ref": "#/$defs/revision"
    },
    "created_at": {
      "$ref": "#/$defs/utc"
    },
    "delivery_expires_at": {
      "$ref": "#/$defs/utc"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP_REQUEST"
          }
        }
      },
      "then": {
        "properties": {
          "actor_side": {
            "const": "SOURCE"
          },
          "relationship_id": {
            "$ref": "#/$defs/id"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "payload": {
            "$ref": "#/$defs/requestPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP_DECISION"
          }
        }
      },
      "then": {
        "properties": {
          "actor_side": {
            "const": "DESTINATION"
          },
          "relationship_id": {
            "$ref": "#/$defs/id"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "payload": {
            "$ref": "#/$defs/decisionPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP_REVOKE"
          }
        }
      },
      "then": {
        "properties": {
          "actor_side": {
            "const": "DESTINATION"
          },
          "relationship_id": {
            "$ref": "#/$defs/id"
          },
          "payload": {
            "$ref": "#/$defs/revokePayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATIONSHIP_STATUS"
          }
        }
      },
      "then": {
        "properties": {
          "relationship_id": {
            "$ref": "#/$defs/id"
          },
          "payload": {
            "$ref": "#/$defs/statusPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SOURCE_AUTHORIZATION_STATUS"
          }
        }
      },
      "then": {
        "properties": {
          "actor_side": {
            "const": "SOURCE"
          },
          "relationship_id": {
            "$ref": "#/$defs/id"
          },
          "payload": {
            "$ref": "#/$defs/sourceAuthorizationPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "CONFIG_ACK"
          }
        }
      },
      "then": {
        "properties": {
          "relationship_id": {
            "$ref": "#/$defs/id"
          },
          "payload": {
            "$ref": "#/$defs/configAckPayload"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "actor_side": {
                  "const": "SOURCE"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "required": [
                    "source_key"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "not": {
                    "required": [
                      "source_key"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PAIR_BLOCK_STATUS"
          }
        }
      },
      "then": {
        "properties": {
          "actor_side": {
            "const": "DESTINATION"
          },
          "relationship_id": {
            "type": "null"
          },
          "request_id": {
            "type": "null"
          },
          "payload": {
            "$ref": "#/$defs/pairBlockStatusPayload"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lifetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "SINGLE_TASK",
            "FIXED",
            "UNTIL_REVOKED"
          ]
        },
        "expires_at": {
          "$ref": "#/$defs/revision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "SINGLE_TASK",
                  "FIXED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "expires_at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "UNTIL_REVOKED"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "expires_at"
              ]
            }
          }
        }
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "lease_revision",
        "mode",
        "effective_from",
        "expires_at",
        "max_tasks",
        "effective_permissions",
        "terms_digest"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "lease_revision": {
          "$ref": "#/$defs/revision"
        },
        "mode": {
          "enum": [
            "SINGLE_TASK",
            "FIXED",
            "UNTIL_REVOKED"
          ]
        },
        "effective_from": {
          "$ref": "#/$defs/revision"
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_tasks": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "terms_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "revokePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revocation_id",
        "lease_id",
        "lease_revision",
        "reason_code",
        "effective_at"
      ],
      "properties": {
        "revocation_id": {
          "$ref": "#/$defs/id"
        },
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "lease_revision": {
          "$ref": "#/$defs/revision"
        },
        "reason_code": {
          "$ref": "#/$defs/id"
        },
        "effective_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "statusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "lease_revision",
        "state",
        "observed_at"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "lease_revision": {
          "$ref": "#/$defs/revision"
        },
        "state": {
          "enum": [
            "CONFIGURING",
            "READY",
            "REVOKED",
            "EXPIRED",
            "CONSUMED",
            "SUSPENDED"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "sourceAuthorizationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "lease_revision",
        "authorization_revision",
        "status",
        "effective_at"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "lease_revision": {
          "$ref": "#/$defs/revision"
        },
        "authorization_revision": {
          "$ref": "#/$defs/revision"
        },
        "status": {
          "enum": [
            "AUTHORIZED",
            "WITHDRAWN"
          ]
        },
        "effective_at": {
          "$ref": "#/$defs/utc"
        }
      }
    },
    "address": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?=[A-Za-z0-9.-]*\\.)[A-Za-z0-9-][A-Za-z0-9.-]{0,251}[A-Za-z0-9-]$",
      "description": "<opaque part>.<provider domain>. PTPAN checks only this envelope; the opaque part is carried byte for byte and never interpreted (D10)."
    },
    "nameText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Plain text, Unicode NFC, no surrounding whitespace, no control or bidirectional-formatting characters (enforced by Base)."
    },
    "personName": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given_name",
        "family_name"
      ],
      "properties": {
        "given_name": {
          "$ref": "#/$defs/nameText"
        },
        "family_name": {
          "$ref": "#/$defs/nameText"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "address"
      ],
      "properties": {
        "platform_id": {
          "$ref": "#/$defs/id"
        },
        "address": {
          "$ref": "#/$defs/address"
        }
      }
    },
    "relationshipRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "request_id",
        "source",
        "source_ownership_revision",
        "requester_name",
        "request_kind",
        "request_revision",
        "base_lease_revision",
        "application_protocol",
        "transport",
        "target_address",
        "requested_permissions",
        "requested_lifetime",
        "created_at",
        "request_expires_at"
      ],
      "properties": {
        "relationship_id": {
          "$ref": "#/$defs/id"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/participant"
        },
        "source_ownership_revision": {
          "$ref": "#/$defs/revision"
        },
        "requester_name": {
          "$ref": "#/$defs/personName"
        },
        "request_kind": {
          "enum": [
            "ESTABLISH",
            "RENEW",
            "MODIFY"
          ]
        },
        "request_revision": {
          "$ref": "#/$defs/revision"
        },
        "base_lease_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "application_protocol": {
          "$ref": "#/$defs/id"
        },
        "transport": {
          "$ref": "#/$defs/id"
        },
        "target_address": {
          "$ref": "#/$defs/address"
        },
        "requested_permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "requested_lifetime": {
          "$ref": "#/$defs/lifetime"
        },
        "created_at": {
          "$ref": "#/$defs/revision"
        },
        "request_expires_at": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "requestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "request_terms_digest"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/relationshipRequest"
        },
        "request_terms_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "decisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "result",
        "bound_request_revision",
        "request_terms_digest",
        "destination_ownership_revision",
        "destination_owner_name",
        "lease"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "enum": [
            "APPROVED",
            "DENIED",
            "BLOCKED"
          ]
        },
        "bound_request_revision": {
          "$ref": "#/$defs/revision"
        },
        "request_terms_digest": {
          "$ref": "#/$defs/digest"
        },
        "destination_ownership_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_owner_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/personName"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease": {
          "oneOf": [
            {
              "$ref": "#/$defs/lease"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "APPROVED"
              }
            }
          },
          "then": {
            "properties": {
              "destination_ownership_revision": {
                "$ref": "#/$defs/revision"
              },
              "destination_owner_name": {
                "$ref": "#/$defs/personName"
              },
              "lease": {
                "$ref": "#/$defs/lease"
              }
            }
          },
          "else": {
            "properties": {
              "destination_ownership_revision": {
                "type": "null"
              },
              "destination_owner_name": {
                "type": "null"
              },
              "lease": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sourceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requester_reference",
        "destination_address",
        "terms_digest",
        "key_purpose",
        "public_key"
      ],
      "properties": {
        "requester_reference": {
          "$ref": "#/$defs/address"
        },
        "destination_address": {
          "$ref": "#/$defs/address"
        },
        "terms_digest": {
          "$ref": "#/$defs/digest"
        },
        "key_purpose": {
          "const": "ed25519_admission"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "configAckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "lease_revision",
        "configuration_revision",
        "key_purpose_revision",
        "acknowledged_at"
      ],
      "properties": {
        "lease_id": {
          "$ref": "#/$defs/id"
        },
        "lease_revision": {
          "$ref": "#/$defs/revision"
        },
        "configuration_revision": {
          "$ref": "#/$defs/revision"
        },
        "key_purpose_revision": {
          "$ref": "#/$defs/revision"
        },
        "acknowledged_at": {
          "$ref": "#/$defs/utc"
        },
        "source_key": {
          "$ref": "#/$defs/sourceKey"
        }
      }
    },
    "pairBlockStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requester_reference",
        "destination_address",
        "state",
        "block_revision",
        "effective_at"
      ],
      "properties": {
        "requester_reference": {
          "$ref": "#/$defs/address"
        },
        "destination_address": {
          "$ref": "#/$defs/address"
        },
        "state": {
          "enum": [
            "BLOCKED",
            "OPEN"
          ]
        },
        "block_revision": {
          "$ref": "#/$defs/revision"
        },
        "effective_at": {
          "$ref": "#/$defs/utc"
        }
      }
    }
  }
}
