{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-admission/v1",
  "title": "Federation Base live admission",
  "description": "Project control profile for one live admission check. This is not an AGNTCY wire standard. It is not a lifecycle outbox event and it does not carry an A2A task body or a destination credential.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_platform",
        "relationship_id",
        "lease_id",
        "lease_revision",
        "source_subject",
        "source_resource",
        "destination_platform",
        "destination_resource",
        "caller_key_purpose",
        "caller_key_revision",
        "audience",
        "challenge_nonce",
        "operation",
        "deadline",
        "source_authorization"
      ],
      "properties": {
        "schema": { "const": "live-admission/v1" },
        "source_platform": { "type": "string", "minLength": 1, "maxLength": 256 },
        "relationship_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lease_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lease_revision": { "type": "integer", "minimum": 1 },
        "source_subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_resource": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination_platform": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination_resource": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caller_key_purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caller_key_revision": { "type": "integer", "minimum": 1 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 256 },
        "challenge_nonce": { "type": "string", "minLength": 1, "maxLength": 256 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deadline": { "type": "integer", "minimum": 1 },
        "source_authorization": { "$ref": "#/$defs/source_authorization" }
      }
    },
    "source_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "relationship_id", "lease_revision", "source_subject", "source_resource", "destination_platform", "audience", "caller_key_purpose", "caller_key_revision", "deadline", "withdrawn"],
      "properties": {
        "nonce": { "type": "string", "minLength": 1, "maxLength": 256 },
        "relationship_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "lease_revision": { "type": "integer", "minimum": 1 },
        "source_subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_resource": { "type": "string", "minLength": 1, "maxLength": 256 },
        "destination_platform": { "type": "string", "minLength": 1, "maxLength": 256 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caller_key_purpose": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caller_key_revision": { "type": "integer", "minimum": 1 },
        "deadline": { "type": "integer", "minimum": 1 },
        "withdrawn": { "const": false }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "result"],
      "properties": {
        "schema": { "const": "live-admission/v1" },
        "result": { "enum": ["ALLOW", "DENY"] },
        "deadline": { "type": "integer", "minimum": 1 },
        "reason": {
          "enum": [
            "PEER_NOT_ACTIVE",
            "NOT_READY",
            "GRANT_DENIED",
            "REUSED_NONCE",
            "STALE_DEADLINE",
            "CHALLENGE_MISMATCH",
            "SOURCE_WITHDRAWN",
            "DURABLE_AUTHORIZED_IS_NOT_PROOF"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "ALLOW" } } },
          "then": { "required": ["deadline"], "not": { "required": ["reason"] } }
        },
        {
          "if": { "properties": { "result": { "const": "DENY" } } },
          "then": { "required": ["reason"], "not": { "required": ["deadline"] } }
        }
      ]
    }
  }
}
